# --- ビルド/パッケージ生成物 ---
# ビルド時に毎回生成される作業フォルダ・配布物（追跡しない）。
build/
dist/
# Chrome Web Store 提出用にパックした拡張 zip。リリース時に都度生成する。
*.zip
*.crx
*.pem
# Codex CLI が作業ディレクトリに残す一時フォルダ。
.codex-tmp/

# --- Node / ツールチェーン（バンドラ・lint 等を使う場合）---
node_modules/
*.tsbuildinfo

# --- ログ・一時ファイル ---
*.log
*.tmp
*.bak
*.orig
*.rej

# --- ローカル・環境設定 ---
.env
.env.*
*.local.md
*.local.json
*.local
*.local.*
.claude/
docs/local/

# --- 認証情報・secrets・鍵（public へ絶対に出さない）---
# 注: 上の dist 用 *.pem（拡張署名鍵）もここで包括される。鍵は絶対にコミットしない。
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
secrets.*
*.secret.*
*credential*
.netrc
.npmrc
.pypirc

# --- OS / エディタ ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# docsweep: backup snapshots (30-day retention, auto-cleanup)
.docsweep/

# Local video production files
/brag-output/
